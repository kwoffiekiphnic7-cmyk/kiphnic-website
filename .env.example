# Copy to .env.local and fill in (never commit real keys).
# Chat — your own AI: any OpenAI-compatible endpoint (FREE: Groq, or OpenRouter free models).
# Groq free tier (no card): https://console.groq.com/keys
#   OPENAI_COMPAT_API_URL=https://api.groq.com/openai/v1/chat/completions
#   OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
OPENAI_COMPAT_API_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
# Chat API (Anthropic) — tried if the endpoint above is unset/failing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Contact API (Gmail SMTP - works without owning a domain).
# 1) Google Account > Security > 2-Step Verification ON
# 2) App passwords > Generate > copy 16-char code (no spaces)
GMAIL_USER=kiphnic7@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=kiphnic7@gmail.com

# Legacy: Resend fallback. Delete when Gmail is active.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=onboarding@resend.dev

# Canonical site origin (SEO/sitemap/OG). Used when a custom domain replaces the free one.
NEXT_PUBLIC_SITE_URL=https://kiphnic-website.vercel.app

# ---- Accounts / login (Upstash Redis or Vercel KV) ----
# Free tier. Create a database at https://console.upstash.com (or Vercel > Storage > KV),
# then copy the REST URL + token. Without these, sign-in is disabled and the chat + game
# links show a friendly "coming soon" instead of an account wall.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: any long random string; sessions are stored server-side in KV regardless.
AUTH_SESSION_SECRET=

