/* Kiphnic global styles — ported 1:1 from V1 prototype (legacy-v1.html) + Next.js additions */
:root{color-scheme:dark;--bg:#03070d;--bg-2:#040a11;--bg-3:#050b13;--bg-4:#061426;--deep:#030912;--panel:#07111d;--panel-2:#081725;--panel-3:#091b2c;--panel-4:#0a2034;--input:#050c14;--card-a:#081725cc;--card-b:#040a12cc;--line:#123451;--line-2:#12466e;--line-3:#16466b;--line-4:#17496d;--line-5:#11324d;--line-6:#126096;--hairline:rgba(0,150,255,.12);--grid:rgba(0,140,255,.02);--text:#f3f8ff;--text-bright:#d9ecff;--text-soft:#c6d4e4;--text-lead:#a9b9cb;--muted:#9aacc0;--muted-2:#879db4;--muted-3:#71869c;--muted-4:#6f8ca9;--muted-5:#5c7894;--on-photo:#f3f8ff;--on-photo-lead:#a9b9cb;--on-photo-muted:#6f8ca9;--accent:#0a9cff;--accent-2:#087cf0;--accent-hi:#05a9ff;--accent-lite:#168dff;--accent-soft:#58baff;--accent-brand:#52aefb;--accent-bright:#28a6ff;--accent-icon:#10a5ff;--on-accent:#fff;--accent-photo:#0a9cff;--accent-photo-2:#087cf0;--accent-photo-hi:#05a9ff;--accent-photo-soft:#58baff;--accent-photo-lite:#168dff;--on-accent-photo:#fff;--nav-bg:rgba(3,7,13,.72);--veil-a:rgba(3,7,13,.9);--veil-b:rgba(3,7,13,.94);--veil-2a:rgba(3,7,13,.82);--veil-2b:rgba(3,7,13,.88);--foot-bg:rgba(3,7,13,.9);--foot-bg-2:rgba(3,7,13,.94);--bubble-bg:rgba(3,7,13,.92);--pop-shadow:0 20px 60px #00000088,0 0 50px #008cff22;--ok:#21e6a1;--danger:#ff7a7a}

    *{box-sizing:border-box;margin:0;padding:0}

    html{scroll-behavior:smooth}

    body{font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden}

    body:before{content:"";position:fixed;inset:0;pointer-events:none;background:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:55px 55px;mask-image:linear-gradient(to bottom,black,transparent 85%);z-index:1}

    a{text-decoration:none;color:inherit}

    .container{width:min(1180px,92%);margin:auto}

    nav{position:fixed;top:0;left:0;right:0;z-index:20;background:var(--nav-bg);backdrop-filter:blur(18px);border-bottom:1px solid var(--hairline)}

    .navin{height:76px;display:flex;align-items:center;justify-content:space-between}

    .brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:.25em}

    .mark{width:38px;height:38px;border:1px solid var(--accent-lite);border-radius:10px;display:grid;place-items:center;color:var(--accent-soft);box-shadow:0 0 22px color-mix(in srgb, var(--accent) 33%, transparent);font-weight:900}

    .brand small{display:block;color:var(--accent-brand);font-size:7px;letter-spacing:.25em;margin-top:3px}

    .links{display:flex;gap:30px;font-size:12px;color:var(--text-soft)}

    .links a:hover{color:var(--accent-bright)}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 20px;border:1px solid var(--accent);border-radius:999px;color:var(--on-accent);font-size:12px;font-weight:700;background:linear-gradient(90deg,var(--accent-2),var(--accent-hi));box-shadow:0 0 24px color-mix(in srgb, var(--accent) 21%, transparent)}

    .btn.alt{background:transparent;color:var(--btn-alt-ink)}

    /* Vertical rhythm scale (all sections reuse these) */
    :root{--sec-pad:72px 0}

    .hero{min-height:62vh;min-height:62svh;padding-top:76px;display:grid;align-items:center;position:relative;overflow:clip;background:transparent}

    .hero:after{content:"";position:absolute;width:700px;height:700px;right:-160px;top:90px;background:radial-gradient(circle,color-mix(in srgb, var(--accent) 20%, transparent),transparent 65%);filter:blur(15px);z-index:0;pointer-events:none}

    .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;position:relative;z-index:1}
    .hero .container{position:relative;z-index:1}

    .hero-art{height:430px;display:grid;place-items:center;position:relative}
    .ai-grid,.vision-grid,.about-grid,.contact-grid{grid-template-columns:1fr}
    .vision{background:linear-gradient(180deg,var(--bg-3),--bg-4)}
    .vision-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:50px}
    .steps{display:grid;gap:15px}
    .step{border-left:2px solid var(--accent);padding:15px 20px;background:var(--panel)}
    .step b{color:var(--accent)}

    h1{font-size:clamp(44px,6.4vw,80px);line-height:.92;letter-spacing:-.045em}

    section{padding:var(--sec-pad);border-top:1px solid var(--hairline)}
    .section-head{max-width:650px;margin-bottom:30px}
    .section-head h2{font-size:clamp(32px,5vw,55px);line-height:1;letter-spacing:-.035em}
    .section-head h2 span{color:var(--accent)}
    .section-head p{color:var(--muted);line-height:1.7;margin:0 0 16px 0}
    .card{background:linear-gradient(145deg,var(--card-a),var(--card-b));border:1px solid var(--line-2);border-radius:14px;padding:28px;min-height:190px;transition:.25s;position:relative;overflow:hidden}
    .project{height:300px;border:1px solid var(--line-2);border-radius:15px;overflow:hidden;position:relative;background:linear-gradient(145deg,var(--panel-4),var(--bg))}
    .project div{position:absolute;bottom:0;left:0;right:0;padding:22px;background:linear-gradient(transparent,var(--bg))}
    .project h3{font-size:17px}
    .project p{color:var(--muted-2);font-size:12px;margin-top:6px}
    .hero-art{display:grid;place-items:center;position:relative}
    .terminal{border:1px solid var(--line-6);border-radius:18px;padding:18px;background:var(--deep);box-shadow:0 0 50px color-mix(in srgb, var(--accent) 9%, transparent)}
    .terminal-top{display:flex;justify-content:space-between;color:var(--muted-5);font-size:10px;border-bottom:1px solid var(--line-5);padding-bottom:12px}
    .chat{padding:50px 25px 25px;min-height:300px}
    .bubble{background:var(--panel-3);border:1px solid var(--line-3);padding:16px;border-radius:12px;color:var(--text-soft);max-width:80%;margin-bottom:18px}
    .input{border:1px solid var(--line-4);border-radius:10px;padding:15px;color:var(--muted-5)}
    footer{padding:35px 0;border-top:1px solid var(--hairline);color:var(--muted-3);font-size:11px;background:var(--foot-bg)}
    .hero-art{background:linear-gradient(180deg,var(--bg-3),var(--bg-4))}
    .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;position:relative;z-index:1}

    .hero{min-height:52vh;min-height:52svh;padding-top:76px;padding-bottom:48px}
    .page-hero{min-height:52vh;min-height:52svh;padding-top:76px;padding-bottom:40px}
    .hero-art{height:400px}
    .page-hero{position:relative;overflow:clip;background:transparent;min-height:52vh;min-height:52svh;display:grid;align-items:center;padding-top:76px}

    .hero-with-bg{isolation:isolate}
    .hero-with-bg .hero-bg{object-fit:cover;object-position:center 30%;z-index:-2}
    .hero-with-bg .hero-shade{position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(90deg,rgba(3,7,13,.55) 0%,rgba(3,7,13,.35) 45%,rgba(3,7,13,.2) 100%),linear-gradient(0deg,rgba(3,7,13,.55) 0%,transparent 40%)}
    .hero-with-bg .hero-art-fallback{display:none}
    .hero-with-bg .hero-grid{grid-template-columns:1.1fr .9fr}
    @media(max-width:850px){.hero-with-bg .hero-bg{object-position:center 20%}.hero-with-bg .hero-shade{background:linear-gradient(180deg,rgba(3,7,13,.42),rgba(3,7,13,.55) 70%,rgba(3,7,13,.75) 100%)}}
    .stat{border:1px solid var(--line-2);border-radius:12px;padding:14px;background:linear-gradient(145deg,var(--card-a),var(--card-b))}
    .cta-banner{padding:40px 0 100px}
    .cta-inner{text-align:center;border:1px solid var(--line-2);border-radius:18px;padding:64px 32px;background:radial-gradient(circle at 50% 0%,color-mix(in srgb, var(--accent) 13%, transparent),transparent 60%),linear-gradient(145deg,var(--card-a),var(--card-b));position:relative;overflow:hidden}
    @media(max-width:850px){.stats-row{grid-template-columns:repeat(3,1fr)}.cta-inner{padding:48px 20px}}
    .founder-quote{margin-top:22px;padding:20px 22px;border-left:2px solid var(--accent);background:var(--panel);border-radius:0 12px 12px 0;color:var(--text-soft);line-height:1.7;font-style:italic}
    .feature-card{margin-top:30px;border:1px solid var(--line-2);border-radius:18px;padding:48px 40px;background:radial-gradient(circle at 50% 0%,color-mix(in srgb, var(--accent) 13%, transparent),transparent 60%),linear-gradient(145deg,var(--card-a),var(--card-b))}
    .social-chip{border:1px solid var(--line-3);border-radius:999px;padding:8px 16px;font-size:11px;letter-spacing:.12em;color:var(--text-soft);transition:.25s}
    .social-chip:hover{border-color:var(--accent);color:var(--accent-soft);box-shadow:0 0 18px color-mix(in srgb, var(--accent) 13%, transparent)}
    .socials{display:grid;gap:10px;margin-top:6px}
    .socials-row{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:850px){.stats-row{grid-template-columns:repeat(3,1fr)}.feature-card{padding:36px 24px}}
